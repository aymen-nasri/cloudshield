# Copy to .env and replace every value. .env is git-ignored.
CLOUDSHIELD_FALCO_TOKEN=replace-me
CLOUDSHIELD_WAZUH_HMAC_SECRET=replace-me
CLOUDSHIELD_REPLAY_HMAC_SECRET=replace-me
POSTGRES_PASSWORD=replace-me
# Every API route needs an analyst. Generate the hash with:
#   python -c "import hashlib; print(hashlib.sha256(b'your-token').hexdigest())"
CLOUDSHIELD_ANALYST_TOKEN=replace-me
CLOUDSHIELD_ANALYSTS='{"sha256-of-your-token":{"id":"analyst:you","roles":["incident-responder"]}}'
# Optional: verify quarantines with real traffic (set all three, with CLOUDSHIELD_EXECUTOR=k8s).
# CLOUDSHIELD_PROBE_POD=shop/probe
# CLOUDSHIELD_PROBE_TOKEN_FILE=/var/run/secrets/cloudshield-prober/token
# CLOUDSHIELD_PROBE_TARGET_SELECTOR=app=checkout
